{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow — a production-style project & task management REST API used to demonstrate a full seven-stage Jenkins DevOps pipeline.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:ci": "eslint . --format json --output-file reports/eslint-report.json || true",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:ci": "jest --runInBand --coverage --ci --reporters=default --reporters=jest-junit",
    "security:audit": "npm audit --audit-level=high --json > reports/npm-audit.json || true",
    "security:retire": "retire --outputformat json --outputpath reports/retire-report.json --exitwith 0 || true",
    "build:artifact": "node scripts/build-artifact.js",
    "smoke": "node scripts/smoke-test.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "devops",
    "jenkins",
    "ci-cd",
    "express",
    "prometheus"
  ],
  "author": "SIT223/SIT753 HD Task",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-jest": "^28.9.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "retire": "^5.2.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "json-summary"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 20000
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}
